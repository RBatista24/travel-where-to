{
  "name": "travel-where-to",
  "private": true,
  "version": "0.1.0",
  "description": "Travel Discovery Engine: find where you can go from origin, dates, travellers, budget and preferences.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @travel-where-to/api --filter @travel-where-to/web dev",
    "dev:api": "pnpm --filter @travel-where-to/api dev",
    "dev:web": "pnpm --filter @travel-where-to/web dev",
    "build:web": "pnpm --filter @travel-where-to/web build",
    "start:api": "pnpm --filter @travel-where-to/api start",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @travel-where-to/web typecheck",
    "test": "tsx --test \"packages/*/src/**/*.test.ts\" \"services/*/src/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "demo": "tsx services/api/src/demo.ts",
    "check:providers": "tsx services/api/src/check-providers.ts",
    "why": "tsx services/api/src/why.ts",
    "explain": "tsx services/api/src/why.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2"
  }
}
