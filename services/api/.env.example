# Copy to services/api/.env and fill in. Never commit .env.
PORT=4000
# 1 = log every provider call as JSON (errors are always logged)
LOG_PROVIDER_CALLS=0

# Flights: mock | travelpayouts
FLIGHT_PROVIDER=mock
# With travelpayouts: routes with no cached price get a labelled distance-based estimate. Set false to drop them instead.
# FLIGHT_ESTIMATE_FALLBACK=true
# Travelpayouts → Profile → API token  (https://www.travelpayouts.com/programs/100/tools/api)
TRAVELPAYOUTS_TOKEN=
# Optional: your Travelpayouts partner id (marker), added to Aviasales links
TRAVELPAYOUTS_MARKER=
# Which market's price cache to read (pt for travellers from Portugal)
TRAVELPAYOUTS_MARKET=pt

# Driving routes: mock | openrouteservice
ROUTING_PROVIDER=mock
# https://openrouteservice.org → sign up → API key
ORS_API_KEY=
# Estimated toll price per km on tolled roads
TOLL_RATE_EUR_PER_KM=0.09

# Weather: mock | open-meteo   (free tier: non-commercial use only, no key)
WEATHER_PROVIDER=mock
# Only for a paid commercial plan
OPEN_METEO_API_KEY=

# Stays: mock | liteapi | serpapi
#  liteapi  = LiteAPI hotel rates (recommended: one call per destination and dates, no monthly cap on the core endpoints)
#  serpapi  = Google Hotels via SerpApi (uses 1 of your SerpApi searches per destination and dates - burns the free 250/month fast)
ACCOMMODATION_PROVIDER=mock
# LiteAPI dashboard → Profile → API key (sandbox key first; production after adding a card)
LITEAPI_KEY=

# Live check of the best flight results: none | serpapi
FLIGHT_VERIFIER=none
# SerpApi dashboard → API key (free plan: 250 searches/month)
SERPAPI_KEY=
# Country for Google results
SERPAPI_GL=pt
# Set true only if `pnpm check:serpapi` shows per-person prices
SERPAPI_PRICE_PER_PERSON=false
# How many top results get a live flight check per search (each costs 1 SerpApi search per departure airport)
VERIFY_TOP=5
